# ── Production environment for the DigitalOcean droplet ──
# Copy to `.env` on the server (deploy script does this for you) and fill in.

# Public hostname that resolves to the droplet's IP. Using sslip.io means no
# domain purchase is needed: replace the dots of the droplet IP with dashes.
# Example: droplet IP 203.0.113.9  ->  SITE_ADDRESS=203-0-113-9.sslip.io
SITE_ADDRESS=REPLACE_WITH_IP_DASHES.sslip.io

# PostgreSQL credentials (the DB is private to the compose network).
POSTGRES_USER=ghartek
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_STRING
POSTGRES_DB=ghartek

# Firebase project id used to verify the ID tokens the app sends.
FIREBASE_PROJECT_ID=pak-delivers

# Optional: mount a Firebase service-account JSON to enable FCM push from the
# backend. Put the file at backend/secrets/serviceAccountKey.json, then set:
GOOGLE_APPLICATION_CREDENTIALS=./secrets/serviceAccountKey.json

# Keep auth verification ON in production.
AUTH_DISABLED=0
