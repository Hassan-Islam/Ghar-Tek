# Copy to .env and adjust. docker-compose maps Postgres to host port 5433.
PORT=8080
DATABASE_URL=postgres://ghartek:ghartek_local_pw@localhost:5433/ghartek

# Firebase project id (login still runs on Firebase Auth). Used to verify the
# ID tokens the app sends. This is the project from lib/firebase_options.dart.
FIREBASE_PROJECT_ID=pak-delivers

# Optional: path to a Firebase service-account JSON. Required ONLY to send FCM
# push notifications from the backend (the job Cloud Functions used to do).
# Auth verification works without it (uses Google public keys + project id).
# Download from Firebase Console -> Project Settings -> Service Accounts.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/serviceAccountKey.json

# Set to 1 to skip auth token verification (LOCAL TESTING ONLY).
AUTH_DISABLED=0
