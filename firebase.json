{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "public",
    "headers": [
      {
        "source": "/app-ads.txt",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/app-ads.txt/",
        "destination": "/app-ads.txt",
        "type": 301
      },
      {
        "source": "/app-ads.txt/app-ads.txt",
        "destination": "/app-ads.txt",
        "type": 301
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}
