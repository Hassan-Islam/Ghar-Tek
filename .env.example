# Copy this file to `.env` and fill in your values. Never commit `.env`.

# Primary Firebase (pak-delivers) — from Firebase Console / FlutterFire CLI
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_PROJECT_ID=pak-delivers
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_WEB_APP_ID=1:000000000000:web:xxxxxxxx
FIREBASE_ANDROID_APP_ID=1:000000000000:android:xxxxxxxx
FIREBASE_IOS_APP_ID=1:000000000000:ios:xxxxxxxx
FIREBASE_IOS_CLIENT_ID=000000000000-your-ios-client-id.apps.googleusercontent.com
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Secondary Firebase app (ratings)
RATINGS_FIREBASE_API_KEY=your_ratings_api_key
RATINGS_FIREBASE_APP_ID=1:000000000000:android:xxxxxxxx
RATINGS_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
RATINGS_FIREBASE_PROJECT_ID=your-ratings-project-id
RATINGS_FIREBASE_DATABASE_URL=https://your-ratings-project-default-rtdb.firebaseio.com

# Mixpanel — from Mixpanel project settings
MIXPANEL_TOKEN=your_mixpanel_token
